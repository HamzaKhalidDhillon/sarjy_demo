# LLM
OPENAI_API_KEY=
GEMINI_API_KEY=
# openai | gemini | offline -- leave blank to auto-pick by whichever key is set above
LLM_PROVIDER=
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# STT (optional local fallback -- requires `pip install -r backend/requirements-whisper.txt`
# and system ffmpeg; see README)
USE_LOCAL_WHISPER=0
LOCAL_WHISPER_MODEL_SIZE=small
LOCAL_WHISPER_DEVICE=cpu

# Cal.com (meeting-booking tool) -- free account + API key, no OAuth. See GOALS.md for setup.
# CALCOM_EVENT_TYPE_ID is optional: if blank, the app uses the account's 30min event type (or
# the first public one). CALCOM_USERNAME is optional too.
CALCOM_API_KEY=
CALCOM_USERNAME=
CALCOM_EVENT_TYPE_ID=
# Cal.com versions its API per-endpoint; these two values are confirmed working against the
# live API. If Cal.com changes them, check cal.com/docs/api-reference/v2.
CALCOM_API_VERSION_SLOTS=2024-09-04
CALCOM_API_VERSION_BOOKINGS=2026-02-25

# Persistence / networking
# SQLite for local dev. In prod (Render) this is the Supabase Session pooler string, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./data/data.db
# Comma-separated list of origins allowed to call this API, or "*" for local dev
ALLOWED_ORIGINS=*
